{
  "$schema": "https://repomix.com/schemas/repomix-config-schema.json",
  "instructionFilePath": ".repomix/instructions.md",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "parsableStyle": true,
    "removeComments": false,
    "removeEmptyLines": true,
    "showLineNumbers": true,
    "topFilesLength": 10
  },
  "include": ["packages/**/*", "apps/**/*", "tsconfig.base.json", "biome.json", "package.json"],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/dist/**",
      "**/node_modules/**",
      "pnpm-lock.yaml",
      ".husky/**",
      ".changeset/**",
      "repomix-*.xml",
      "repomix-output.*",
      "docs/**",
      "**/*.api.md",
      "**/*.mp4",
      "**/*.webm",
      "**/*.mp3",
      "**/*.svg",
      "**/*.png",
      "**/*.jpg"
    ]
  }
}
