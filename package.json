{
  "name": "web-react-player-monorepo",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --filter \"./packages/**\" --parallel dev",
    "dev:app": "pnpm --filter playground dev",
    "build": "pnpm --filter \"./packages/**\" build",
    "build:app": "pnpm --filter playground build",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "clean": "pnpm -r exec node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm --filter \"./packages/**\" test",
    "lint:spell": "cspell \"**/*.{ts,tsx,js,jsx,json,md}\" --no-progress",
    "api:check": "pnpm --filter \"./packages/**\" exec api-extractor run",
    "api:update": "pnpm --filter \"./packages/**\" exec api-extractor run --local",
    "docs:api": "typedoc",
    "repomix": "repomix",
    "repomix:pure": "repomix --config .repomix/repomix.pure.json",
    "repomix:full": "repomix --config .repomix/repomix.full.json",
    "repomix:core": "repomix packages/core -o repomix-core.xml",
    "repomix:ui": "repomix packages/ui -o repomix-ui.xml",
    "repomix:app": "repomix apps/playground -o repomix-playground.xml",
    "check:knip": "knip",
    "check:syncpack": "syncpack lint --dependency-types prod,dev,peer",
    "fix:syncpack": "syncpack fix --dependency-types prod,dev,peer",
    "check:deps": "depcruise packages --config .dependency-cruiser.cjs",
    "check:security": "socket scan",
    "test:mutation": "stryker run",
    "check:publint": "pnpm --filter \"./packages/**\" exec publint",
    "check:attw": "pnpm --filter \"./packages/**\" exec attw --pack . --profile esm-only",
    "check:size": "size-limit",
    "check:packages": "pnpm build && pnpm check:publint && pnpm check:attw && pnpm check:size && pnpm api:check",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.14",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@microsoft/api-extractor": "^7.59.1",
    "@size-limit/preset-small-lib": "^14.0.0",
    "@socketsecurity/cli": "^1.1.176",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "cspell": "^10.3.3",
    "dependency-cruiser": "^18.3.1",
    "fast-check": "^4.10.1",
    "husky": "^9.1.7",
    "knip": "^6.37.0",
    "lint-staged": "^17.5.1",
    "publint": "^0.3.24",
    "repomix": "^1.18.0",
    "size-limit": "^14.0.0",
    "syncpack": "^15.3.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^5.8.2",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
