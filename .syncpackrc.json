{
  "$schema": "https://unpkg.com/syncpack/schema.json",
  "semverGroups": [
    {
      "range": "^",
      "dependencies": ["**"],
      "packages": ["**"]
    }
  ],
  "versionGroups": [
    {
      "label": "React peer range intentionally supports both React 18 and 19",
      "dependencies": ["react", "react-dom"],
      "dependencyTypes": ["peer"],
      "packages": ["**"],
      "isIgnored": true
    },
    {
      "label": "Пакеты монорепозитория всегда используют workspace:*",
      "dependencies": ["@web-react-player/*"],
      "packages": ["**"],
      "pinVersion": "workspace:*"
    }
  ]
}
