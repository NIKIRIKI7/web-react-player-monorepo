{
  "$schema": "https://typedoc.org/schema.json",
  "plugin": ["typedoc-plugin-markdown"],
  "entryPointStrategy": "packages",
  "entryPoints": ["packages/core", "packages/ui"],
  "out": "docs/api",
  "cleanOutputDir": true,
  "readme": "none",
  "hideGenerator": true,
  "excludePrivate": true,
  "excludeInternal": true
}
