{
  "name": "@web-react-player/ui",
  "version": "1.1.0",
  "description": "Headless, accessible UI primitives and YouTube-like layout for Web React Player: TimeSlider, Captions, Gestures, Ambient Glow, Hotkeys, and Menus.",
  "author": "Никита Горобец",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "keywords": [
    "react",
    "player",
    "video-ui",
    "headless",
    "accessibility",
    "captions",
    "karaoke",
    "hotkeys",
    "ambient-glow",
    "timeslider"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NIKIRIKI7/web-react-player-monorepo.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/NIKIRIKI7/web-react-player-monorepo/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/NIKIRIKI7/web-react-player-monorepo/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "test": "vitest run",
    "prepublishOnly": "pnpm --filter @web-react-player/core run build && pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@web-react-player/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.8.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.1"
  }
}
