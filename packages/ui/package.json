  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.8.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0"
  }
}