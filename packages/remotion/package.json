{
  "name": "@web-react-player/remotion",
  "version": "0.2.0",
  "description": "Remotion integration suite for Web React Player: in-browser TSX compiler, WebCodecs MP4/WebM exporter, dynamic audio mixer, scenario adapters and widget runtime.",
  "author": "Никита Горобец",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "keywords": [
    "react",
    "player",
    "remotion",
    "video-editor",
    "video-player",
    "audio-mixer",
    "motion-graphics",
    "tsx-compiler",
    "webcodecs",
    "canvas-export",
    "tree-shaking",
    "browser"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NIKIRIKI7/web-react-player-monorepo.git",
    "directory": "packages/remotion"
  },
  "homepage": "https://github.com/NIKIRIKI7/web-react-player-monorepo/tree/main/packages/remotion#readme",
  "bugs": {
    "url": "https://github.com/NIKIRIKI7/web-react-player-monorepo/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "test": "vitest run",
    "prepublishOnly": "pnpm --filter @web-react-player/core run build && pnpm --filter @web-react-player/ui run build && pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@remotion/media": "^4.0.527",
    "@remotion/player": "^4.0.526",
    "@remotion/web-renderer": "^4.0.526",
    "@web-react-player/core": "workspace:*",
    "@web-react-player/ui": "workspace:*",
    "lucide-react": "^1.47.0",
    "remotion": "^4.0.526",
    "sucrase": "^3.35.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.8.2",
    "vitest": "^5.0.1",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0"
  }
}
